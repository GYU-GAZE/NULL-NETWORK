[sub_resource type="Resource" id="Post_OP"]
script = ExtResource("2_post")
post_number = 73144201
subject = "multiplayer recs for a new kubuos owner?"
author_name = "Anonymous"
uid = "7C2F91"
timestamp = "08/11/26 (Tue) 21:18:04"
body_text = "got a used KUBUSU for basically nothing. what does anyone actually play on this thing?\n\nlooking for multiplayer. co-op, versus, persistent weird shit, whatever. i don't care if it's ancient as long as there are still actual people on the other end."
is_op = true

[sub_resource type="Resource" id="Post_1"]
script = ExtResource("2_post")
post_number = 73144218
author_name = "Anonymous"
uid = "18B0D4"
timestamp = "08/11/26 (Tue) 21:22:41"
body_text = ">>73144201\nGRIDLOCK/8 still gets rooms around 9pm. Kubu Tactics Online has like twelve japanese guys who have apparently sworn a blood oath never to quit.\n\nPocket Marshal works if you already know three other people who own one."

[sub_resource type="Resource" id="Post_2"]
script = ExtResource("2_post")
post_number = 73144227
author_name = "Anonymous"
uid = "E340AF"
timestamp = "08/11/26 (Tue) 21:25:09"
body_text = "that's basically the whole list lol\n\nKubu sells a computer the size of a sandwich, locks the OS down like a bank terminal and then acts surprised when nobody ports games to it. corpse ecosystem."

[sub_resource type="Resource" id="Post_3"]
script = ExtResource("2_post")
post_number = 73144241
author_name = "Anonymous"
uid = "5A72CC"
timestamp = "08/11/26 (Tue) 21:31:53"
body_text = ">>73144201\nMIRROR//RELAY was good before auth died. some private rooms still work if you know where to point the client.\n\nand don't say null network or the fucking bot will find the thread."

