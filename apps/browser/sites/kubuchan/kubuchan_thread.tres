[sub_resource type="Resource" id="Post_OP"]
script = ExtResource("2_post")
post_number = 73144201
subject = "multiplayer recs for a new kubuos owner?"
author_name = "Anonymous"
uid = "7C2F91"
timestamp = "08/11/26 (Tue) 21:18:04"
body_text = "picked up a used KUBUSU for basically nothing. what does anyone actually play on this thing?\n\nlooking for multiplayer specifically. co-op, versus, weird persistent stuff, whatever. i don't care if it's old as long as there are still human beings on the other end."
is_op = true

[sub_resource type="Resource" id="Post_1"]
script = ExtResource("2_post")
post_number = 73144218
author_name = "Anonymous"
uid = "18B0D4"
timestamp = "08/11/26 (Tue) 21:22:41"
body_text = ">>73144201\nGRIDLOCK/8 still gets rooms around 9pm. Kubu Tactics Online has a tiny JP crowd that refuses to die.\n\nPocket Marshal if you already know three other people who own one of these."

[sub_resource type="Resource" id="Post_2"]
script = ExtResource("2_post")
post_number = 73144227
author_name = "Anonymous"
uid = "E340AF"
timestamp = "08/11/26 (Tue) 21:25:09"
body_text = "that's basically the whole list lol\n\nKubu sells a computer the size of a sandwich and then acts surprised when nobody ports games to it. half the store is productivity toys and corporate training software."

[sub_resource type="Resource" id="Post_3"]
script = ExtResource("2_post")
post_number = 73144241
author_name = "Anonymous"
uid = "5A72CC"
timestamp = "08/11/26 (Tue) 21:31:53"
body_text = ">>73144201\nMIRROR//RELAY was good before auth died. some private rooms still work if you know where to point the client.\n\nthere's also that monster thing but i'm not opening that argument again."

