[sub_resource type="Resource" id="Post_5"]
script = ExtResource("2_post")
post_number = 73144270
author_name = "Anonymous"
uid = "91D5E0"
timestamp = "08/11/26 (Tue) 21:40:36"
body_text = ">>73144255\nNull Network isn't even really a KubuOS game. pretty sure it's a cancelled Kubu project somebody gutted, rebuilt out of scraps and kept patching until the original thing underneath stopped being recognizable.\n\nclient feels like five incompatible programs wearing the same skin."

[sub_resource type="Resource" id="Post_6"]
script = ExtResource("2_post")
post_number = 73144278
author_name = "Anonymous"
uid = "44B8FA"
timestamp = "08/11/26 (Tue) 21:43:58"
body_text = ">>73144270\nnot exactly. WEWERE had a build before the public APK existed. same handshake strings, same asset names, same dead endpoints.\n\npeople call it a salvage because that's less stupid than the alternatives."

[sub_resource type="Resource" id="Post_7"]
script = ExtResource("2_post")
