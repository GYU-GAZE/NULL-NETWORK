@tool
extends RefCounted
class_name BrowserAuthoringFixture

const ROOT: String = "res://.godot/browser_authoring_fixture"
const URL: String = "acceptance.local"
const FLAG: String = "test.browser.authoring.allowed"
const EFFECT: String = "test.browser.authoring.executed"


static func build() -> Dictionary:
	DirAccess.make_dir_recursive_absolute(ROOT)
	# Only this ignored fixture directory is reused. Production catalogs/content
	# are never overwritten by the regression test.
	for file: String in ["home.tscn", "home.tres", "second.tscn", "second.tres", "application.tscn", "application.tres", "viewport.tscn", "viewport.tres", "catalog.pending.tres"]:
		if FileAccess.file_exists(ROOT.path_join(file)):
			DirAccess.remove_absolute(ROOT.path_join(file))
	var catalog_path := ROOT.path_join("catalog.tres")
	ResourceSaver.save(WebsiteCatalog.new(), catalog_path)
	var created: Array[Dictionary] = []
	for spec: Array in [["home", URL, "document"], ["second", URL + "/second", "document"], ["application", URL + "/application", "application"], ["viewport", URL + "/viewport", "viewport"]]:
		var result := WebsiteAuthoring.create_page({"name": spec[0], "url": spec[1], "title": "Authoring Acceptance / " + spec[0], "folder": ROOT, "catalog": catalog_path, "template": spec[2]})
		if not result.ok:
			return result
		created.append(result)
	for spec: Array in [[created[0], URL + "/second"], [created[1], URL]]:
		var scene := ResourceLoader.load(spec[0].scene, "", ResourceLoader.CACHE_MODE_IGNORE) as PackedScene
		var root := scene.instantiate() as Control
		var content := root.get_node("Content") as VBoxContainer
		var field := LineEdit.new()
		field.name = "NameField"
		field.placeholder_text = "State belongs to this history entry"
		_add(root, content, field)
		(root.get_node("FormState") as BrowserFormState).fields.assign([NodePath("../Content/NameField"), NodePath("../Content/ExtraContent")])
		var columns := ResponsiveColumns.new()
		columns.name = "Columns"
		_add(root, content, columns)
		for index: int in range(2):
			var panel := PanelContainer.new()
			panel.custom_minimum_size.x = 180
			panel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			_add(root, columns, panel)
			var label := Label.new()
			label.text = "Column %d: this panel stacks when both minimum widths no longer fit." % (index + 1)
			label.autowrap_mode = TextServer.AUTOWRAP_WORD
			_add(root, panel, label)
		var reusable := (load("res://apps/browser/components/navigation_button.tscn") as PackedScene).instantiate() as SiteActionButton
		reusable.name = "NextPage"
		reusable.text = "Open the other authored page"
		reusable.action_data = SiteActionData.new()
		reusable.action_data.target_url = spec[1]
		_add(root, content, reusable)
		var gate := SiteActionButton.new()
		gate.name = "ConditionalAction"
		gate.text = "Conditional action"
		gate.action_data = _conditional_action()
		_add(root, content, gate)
		var enabling := SiteActionButton.new()
		enabling.name = "EnableAction"
		enabling.text = "Unlock the conditional action"
		enabling.action_data = SiteActionData.new()
		var flag := SetFlagEffectData.new()
		flag.effect_id = "fixture.enable"
		flag.flag_name = FLAG
		flag.value = true
		enabling.action_data.effects.assign([flag])
		_add(root, content, enabling)
		var toggle := Button.new()
		toggle.name = "Expand"
		toggle.text = "Show more content"
		_add(root, content, toggle)
		var expansion := VisibilityToggle.new()
		expansion.target_path = NodePath("../../ExtraContent")
		_add(root, toggle, expansion)
		var extra := Label.new()
		extra.name = "ExtraContent"
		extra.text = "Dynamically revealed content.\n".repeat(20)
		extra.visible = false
		extra.autowrap_mode = TextServer.AUTOWRAP_WORD
		_add(root, content, extra)
		var body := Label.new()
		body.name = "LongBody"
		body.text = "A long authored document. The footer must remain reachable.\n".repeat(32)
		body.autowrap_mode = TextServer.AUTOWRAP_WORD
		_add(root, content, body)
		root.get_node("Footer").text = "REAL DOCUMENT END"
		var packed := PackedScene.new()
		packed.pack(root)
		root.free()
		ResourceSaver.save(packed, spec[0].scene)
		ResourceLoader.load(spec[0].scene, "", ResourceLoader.CACHE_MODE_REPLACE)
	# Force a fresh load: these are files generated by the plugin's exact service,
	# then edited as content. No Browser/DNS/window infrastructure is touched.
	var catalog := ResourceLoader.load(catalog_path, "", ResourceLoader.CACHE_MODE_REPLACE) as WebsiteCatalog
	return {"ok": true, "catalog": catalog, "catalog_path": catalog_path, "created": created}


static func _add(root: Node, parent: Node, child: Node) -> void:
	parent.add_child(child)
	child.owner = root


static func _conditional_action() -> SiteActionData:
	var action := SiteActionData.new()
	var condition := FlagConditionData.new()
	condition.flag_name = FLAG
	action.conditions = condition
	var effect := SetFlagEffectData.new()
	effect.effect_id = "fixture.execute"
	effect.flag_name = EFFECT
	effect.value = true
	action.effects.assign([effect])
	action.show_failed_alert = true
	action.failed_alert_title = "LOCKED FIXTURE"
	action.failed_alert_message = "Unlock this action first."
	action.notification = KubuNotificationData.new()
	action.notification.title = "STRUCTURED SUCCESS"
	action.notification.message = "The same authored action can be triggered by any control."
	action.notification.source_app_id = "browser"
	action.notification.target_url = URL + "/second"
	action.notification.priority = KubuNotificationData.NotificationPriority.HIGH
	action.notification.notification_type = KubuNotificationData.NotificationType.QUEST
	return action
