extends EcologyIntegrationHarness

func run() -> void:
	seed(5050)
	await boot("ecology_flow")
	var zone := area.map_location.ecology_zone
	var actors := configure_call_actors(false)
	await request_fight(actors[0])
	await complete_action("purify", CombatManager.enemy_team[0])
	check(EcologyService.resonance(zone.ecology_zone_id, "rattildus") == 0, "Pending PURIFY committed before formal resolution")
	var time := TimeManager.get_total_action_index()
	for attempt: int in range(100):
		if navigator.combat_app.resolution_panel.visible: break
		navigator.combat_app.run_away_btn.pressed.emit()
		await get_tree().process_frame
	await return_from_fight()
	check(EcologyService.resonance(zone.ecology_zone_id, "rattildus") == 0 and not CampaignState.known_module_ids.has("rattildus_guard") and TimeManager.get_total_action_index() == time, "Escape committed PURIFY resonance/passive/time")
	actors = configure_call_actors(false)
	await request_fight(actors[0])
	await complete_action("purify", CombatManager.enemy_team[0])
	await win_current_fight()
	check(EcologyService.resonance(zone.ecology_zone_id, "rattildus") == 1 and EcologyService.population(zone.ecology_zone_id, "rattildus") == 5 and CampaignState.known_module_ids.has("rattildus_guard"), "Formal PURIFY did not grant a valid passive/resonance while preserving population")
	await return_from_fight()
	await capture("ecology_after_purify")
	actors = configure_call_actors(false)
	await request_fight(actors[0])
	await complete_action("scan", CombatManager.enemy_team[0])
	await win_current_fight()
	await return_from_fight()
	check(CampaignState.known_module_ids.has("heavy_attack") and EcologyService.population(zone.ecology_zone_id, "rattildus") == 5 and EcologyService.resonance(zone.ecology_zone_id, "rattildus") == 1, "SCAN changed ecology or lost its selected Module")
	actors = configure_call_actors(false)
	await request_fight(actors[0])
	await complete_action("tame", CombatManager.enemy_team[0])
	check(await until(func() -> bool: return navigator.combat_app.resolution_panel.visible), "TAME did not reach the real resolution UI")
	await return_from_fight()
	check(CampaignState.partner.apk_id == "rattildus_init" and EcologyService.population(zone.ecology_zone_id, "rattildus") == 5 and EcologyService.resonance(zone.ecology_zone_id, "rattildus") == 1, "TAME failed adoption or changed ecology")
	var partner := APKProgressionService.create_partner_state("novire_init", "Ecology acceptance", 0, 0)
	partner.level = 90
	partner.current_exp = APKProgressionService.get_total_exp_for_level(90)
	partner.allocation_points = 89
	partner.current_hp = int(APKProgressionService.calculate_partner_stats(partner).get("max_hp", 1))
	check(CampaignState.set_partner_state(partner), "Post-TAME acceptance partner fixture is invalid")
	actors = configure_call_actors(false)
	await request_fight(actors[0])
	await complete_action("purge", CombatManager.enemy_team[0])
	await win_current_fight()
	check(int(CombatManager.get_result_metadata().experience) == 12, "PURGE did not apply 3x after weak-enemy penalty")
	await return_from_fight()
	check(EcologyService.population(zone.ecology_zone_id, "rattildus") == 4 and ordinary_exes().is_empty(), "Physical tombstones and ecological signatures were conflated")
	check(SaveManager.manual_save() and SaveManager.load_campaign("ecology_flow").is_empty(), "Ecological field results could not save/load")
	await settle(0.1)
	area = navigator.local_area_view.get_current_area_instance()
	check(ordinary_exes().is_empty(), "Reload immediately respawned spent physical actors")
	await next_day()
	for index: int in range(3):
		actors = configure_call_actors(false)
		check(not actors.is_empty(), "Ecological reduction removed every eligible target early")
		if actors.is_empty(): break
		await request_fight(actors[0])
		await complete_action("purge", CombatManager.enemy_team[0])
		await win_current_fight()
		await return_from_fight()
	check(EcologyService.population(zone.ecology_zone_id, "rattildus") == 1 and ordinary_exes().size() == 1 and not bool(EcologyService.snapshot(zone.ecology_zone_id).collapsed), "Last active signature is not visibly distinct from collapse")
	await capture("ecology_last_signature")
	while TimeManager.days_passed < 4: await next_day()
	check(SaveManager.manual_save() and SaveManager.load_campaign("ecology_flow").is_empty(), "Pre-Micro-Update checkpoint could not restore")
	await settle(0.1)
	area = navigator.local_area_view.get_current_area_instance()
	var experience := CampaignState.partner.current_exp
	await next_day()
	check(TimeManager.days_passed == 5 and EcologyService.population(zone.ecology_zone_id, "rattildus") == 3 and ordinary_exes().size() == 3, "Real weekly Micro-Update did not recover 1/5 +2 => 3/5 and recompile field actors")
	check(CampaignState.partner.current_exp == experience, "QA Micro-Update granted artificial EXP")
	await capture("ecology_micro_update_recovery")
	check(SaveManager.manual_save() and SaveManager.load_campaign("ecology_flow").is_empty(), "Post-Micro-Update checkpoint could not restore")
	await settle(0.1)
	area = navigator.local_area_view.get_current_area_instance()
	check(EcologyService.population(zone.ecology_zone_id, "rattildus") == 3 and ordinary_exes().size() == 3, "Reload duplicated weekly recovery")
	await dispose()
	finish("ECOLOGY_FLOW_TEST")
