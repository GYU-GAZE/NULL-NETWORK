extends FieldIntegrationHarness

func run() -> void:
	await boot("legacy_migration_setup")
	var storage := "user://phase03_field_migration"
	SaveManager.configure_storage_root(storage)
	var fixture := FileAccess.get_file_as_string("res://tests/field/fixtures/phase03_reserved_combat.json")
	var document: Dictionary = JSON.parse_string(fixture)
	var transaction_id := str(document.sections.navigator_state.activity_transaction_id)
	var legacy_id := str(document.sections.navigator_state.pending_exe_interaction_id)
	check(int(document.sections.activity_transactions.transactions[transaction_id].action_cost) == 2, "Fixture no longer proves migration of the Phase 03 reservation")
	var destination := storage.path_join("navigator_activity/live.json")
	DirAccess.make_dir_recursive_absolute(destination.get_base_dir())
	DirAccess.make_dir_recursive_absolute(destination.get_base_dir().path_join("checkpoints"))
	var file := FileAccess.open(destination, FileAccess.WRITE)
	file.store_string(fixture)
	file.close()
	check(SaveManager.load_campaign("navigator_activity").is_empty(), "Unmodified Phase 03 combat save was rejected")
	await settle(0.1)
	area = navigator.local_area_view.get_current_area_instance()
	check(navigator._current_mode == NavigatorApp.NavigatorMode.ENCOUNTER and CombatManager.is_encounter_active(), "Legacy encounter did not resume in the existing CombatApp")
	check(navigator._pending_exe_actor != null and navigator._pending_exe_actor.get_interaction_id() == legacy_id, "Active legacy participant identity was lost during population migration")
	check(CombatManager.get_current_encounter().field_formation.is_empty(), "Legacy authored fight was silently replaced by a dynamic formation")
	var transaction := ActivityManager.get_active_transaction(transaction_id)
	check(int(transaction.get("action_cost", 0)) == 1 and int(transaction.get("migrated_cost_from", 0)) == 2, "Saved uncharged two-block combat reservation was not reconciled to one block")
	var initial := TimeManager.get_total_action_index()
	await win_current_fight()
	await return_from_fight()
	check(TimeManager.get_total_action_index() == initial + 1, "Migrated voluntary fight settled the old two-block cost")
	check(area.find_interactable_by_id(legacy_id) == null, "Resolved legacy encounter actor respawned after migration")
	check(area.get_field_exes().size() == 3 and ActivityManager.export_save_data().transactions.is_empty(), "Legacy settlement duplicated environmental units or left an orphan transaction")
	var saved := SaveManager.manual_save()
	check(saved, "Migrated legacy save could not be saved again: %s" % SaveManager.get_last_errors())
	check(SaveManager.load_campaign("navigator_activity").is_empty(), "Migrated legacy save could not be loaded again")
	await dispose()
	finish("FIELD_LEGACY_SAVE_TEST")
