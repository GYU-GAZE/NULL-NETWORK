[sub_resource type="Resource" id="Notification_installed"]
script = ExtResource("7_notification")
notification_id = "app.profile.installed"
title = "PROFILE INSTALLED"
message = "Operator and registered partner data are now available."
source_app_id = "profile"
notification_type = 6

[sub_resource type="Resource" id="Partner_required"]
script = ExtResource("6_partner")

[sub_resource type="Resource" id="Conditions_has_partner"]
script = ExtResource("4_set")
rules = Array[ExtResource("5_rule")]([SubResource("Partner_required")])

[resource]
script = ExtResource("1_app")
app_id = "profile"
app_name = "Profile"
app_icon = ExtResource("2_icon")
app_scene = ExtResource("3_scene")
auto_install_when_unlocked = true
unlock_conditions = SubResource("Conditions_has_partner")
