[sub_resource type="Resource" id="Effect_installation_flag"]
script = ExtResource("5_set_flag")
flag_name = "kubu_os.app.navigator_installed"
effect_id = "app.navigator.mark_installed"

[sub_resource type="Resource" id="Notification_installed"]
script = ExtResource("4_notification")
notification_id = "app.navigator.installed"
title = "NAVIGATOR INSTALLED"
message = "Navigator is now available in the KubuOS dock."
