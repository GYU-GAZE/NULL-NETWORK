[gd_resource type="Resource" script_class="ThreadButtonData" load_steps=8 format=3]

[ext_resource type="Script" path="res://data/templates/thread_button_data.gd" id="1_button"]
[ext_resource type="Script" path="res://data/templates/forum_thread.gd" id="2_thread"]
[ext_resource type="Script" path="res://data/templates/forum_post.gd" id="3_post"]
[ext_resource type="Script" path="res://data/templates/network_user_data.gd" id="4_user"]
[ext_resource type="Texture2D" path="res://icon.svg" id="5_icon"]

[sub_resource type="Resource" id="User_system_test"]
script = ExtResource("4_user")
user_id = "null_system_test"
display_name = "NULL SYSTEM"
avatar = ExtResource("5_icon")
title = "Integration Monitor"
location = "TOKYO, JAPAN"
role = 2
global_rank = 0
server_name = "TOKYO, JAPAN"
status_message = "Temporary test content is active."
bio_bbcode = "[b]Development-only integration account.[/b]"

[sub_resource type="Resource" id="Post_checklist"]
script = ExtResource("3_post")
author = SubResource("User_system_test")
post_id = "field_test_checklist"
time_label_override = "BOOTSTRAP"
is_op = true
is_system_post_override = true
release_day = 1
release_period = 0
release_action_block = 0
text_content = "[b]TEMPORARY SYSTEMS FIELD TEST[/b]\n\nRegistration should have created a NOVIRE partner, installed Navigator and synchronized your forum identity.\n\n1. Click [url=lead://integration_field_test]FOLLOW THE AKIHABARA RELAY[/url].\n2. Open Navigator from the KubuOS dock.\n3. Select Akihabara and confirm the one-block travel activity.\n4. Move with WASD and interact with E.\n5. Approach a Rattildus actor to start a voluntary two-block combat.\n6. Test Modules and the SCAN, PURGE, PURIFY and TAME Timeline actions.\n7. The Lead also projects an Incident actor into the same Local Area.\n8. Close and reload the campaign at stable boundaries to verify persistence.\n\nThis thread is integration content, not final narrative canon."

[sub_resource type="Resource" id="Thread_field_test"]
script = ExtResource("2_thread")
thread_id = "integration_field_test"
thread_title = "SYSTEMS FIELD TEST // AKIHABARA ROUTE"
thread_label = "DEV"
thread_category = 0
thread_tags = Array[String](["integration", "navigator", "combat", "lead"])
is_pinned = true
popularity_score = 9999
thread_preview = "A guided route through registration, dialogue, Navigator, Local Area, Leads and combat."
posts = Array[ExtResource("3_post")]([SubResource("Post_checklist")])

[resource]
script = ExtResource("1_button")
thread_ref = SubResource("Thread_field_test")
release_day = 1
release_period = 0
