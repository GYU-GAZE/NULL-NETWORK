[node name="IntroductionLabel" type="Label" parent="PageMargin/Page/ContentFrame/ContentMargin/ContentVBox/GuideBody/ArticlePanel/ArticleMargin/ArticleVBox/ArticleScroll/ArticleContent"]
unique_name_in_owner = true
layout_mode = 2
text = "Hello Cobalt community,\n\nMy name is Morris and this is a fan project I began back in college in the mid 2000s. Piecing together the source code of Cobalt Blue from decompiled scraps has been one of the most challenging but rewarding experiences of my life. It’s been a lot of help from all of you along the way, and while it can’t be called a 1 to 1 recreation, I believe we’ve expanded upon Cobalt’s vision in a meaningful way.\n\nAs you may know, I’ve started my own gaming studio, M8Goods. This means I’ve had less time to dedicate to updating the game. This site is solely run by volunteer staff, the players, and unpaid organizers who help keep the app functioning on iOS and Android out of love. Due to copyright issues, we’ve never been able to monetize this project or secure an official release. It’s thanks to your generous donations that this website stays afloat.\n\nGoing forward, the moderation team will be taking the reins on this project and I’m sure they’ll do the community justice! For now, consider this the definitive version of the game and the last patch (r1) I’ll be taking part in.\n\nThank you all for playing and keeping the world safe.\n\nMorris_the_Worm8"
horizontal_alignment = 1
autowrap_mode = 2

[node name="GetStartedLabel" type="Label" parent="PageMargin/Page/ContentFrame/ContentMargin/ContentVBox/GuideBody/ArticlePanel/ArticleMargin/ArticleVBox/ArticleScroll/ArticleContent"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "1  Upon starting the game, you will be prompted to enter a player name that is bound to your account. Choose wisely, as this cannot be changed later.\n\n2  The creatures you will encounter are APKs: living programs whose Integrity and behaviour are shaped by their data.\n\n3  NULL NETWORK is a game about making a memorable companion. Your Compatibility Assessment can match you with a partner, while Manual Allocation lets you select from the standard roster.\n\n4  Your Tendencies — VALOUR, LOGIC, SYNC and SELF — grow through decisions and combat behaviour. They shape evolution without replacing your direct tactical choices.\n\n5  During combat, SCAN, PURGE, PURIFY and TAME occupy Timeline slots. Each action changes the reward and the relationship you form with the target.\n\n6  Always be on guard. APK loss is permanent, and a careless Operator can leave more behind than progress."
autowrap_mode = 2

[node name="GlossaryLabel" type="Label" parent="PageMargin/Page/ContentFrame/ContentMargin/ContentVBox/GuideBody/ArticlePanel/ArticleMargin/ArticleVBox/ArticleScroll/ArticleContent"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "ADMINISTRATOR  A player who controls the majority of an area’s Data Centers.\n\nAGGRO LOCK  A state where an Operator is inside an enemy’s range and cannot safely exit.\n\nBLACKHAT  A playstyle centered on consumption, exploitation and forbidden systems.\n\nDATA CENTER  A fixed stronghold protected by a powerful APK.\n\nDEAD ZONE  A location with no active Operators and an unusually dense program ecosystem.\n\nINDEX  The act of gathering complete map information about an area.\n\nWHITEHAT  A purification-focused playstyle chosen after learning that other paths exist."
autowrap_mode = 2

[node name="PortalFooter" parent="PageMargin/Page" instance=ExtResource("5_footer")]
