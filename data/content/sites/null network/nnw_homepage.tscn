[node name="DescriptionLabel" type="Label" parent="MasterScroll/PageMargin/PageVBox/HeroPanel/HeroMargin/HeroVBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.105882, 0.211765, 0.301961, 1)
theme_override_constants/line_spacing = 4
text = "In the lead-up to the devastating Y2K virus, a mass purge of data opened a rift between the world of man and computers. Now, electronic specters from the digital realm are trying to invade the world of the living!\n\nGear up with futuristic goggles and photon weaponry that lets you do battle with vicious viruses, woeful worms and apocalyptic A.I. — each one hellbent on overwriting humanity.\n\nUsing the latest innovations in augmented reality, take the fight from your screen straight into your home! A gaming experience like nothing you've seen before!\n\nFrom the brilliant mind of Tarou Yamada.\n\nコバルトブルー\n© 2000"
horizontal_alignment = 1
autowrap_mode = 2

