[sub_resource type="Resource" id="Effect_mark_complete"]
script = ExtResource("8_set_flag")
flag_name = "story.prologue.welcome_complete"
effect_id = "story.prologue.mark_welcome_complete"

[sub_resource type="Resource" id="Condition_account_ready"]
script = ExtResource("6_flag_condition")
flag_name = "story.prologue.account_ready"

[sub_resource type="Resource" id="Conditions_root"]
script = ExtResource("5_condition_set")
rules = Array[ExtResource("4_rule")]([SubResource("Condition_account_ready")])

[sub_resource type="Resource" id="Step_open_browser"]
script = ExtResource("3_step")
step_id = "open_browser"
step_type = 2
app_id = "browser"

[sub_resource type="Resource" id="Step_navigate_browser"]
script = ExtResource("3_step")
step_id = "navigate_null_network"
step_type = 3
browser_url = "null.net"

[sub_resource type="Resource" id="Step_show_alert"]
script = ExtResource("3_step")
step_id = "show_welcome_alert"
title = "NULL NETWORK"
message = "Connection established. Your account is ready."

[sub_resource type="Resource" id="Step_show_notification"]
script = ExtResource("3_step")
step_id = "show_welcome_notification"
step_type = 1
title = "NAVIGATOR INSTALLED"
message = "Navigator is now available from the KubuOS dock. The systems field-test thread contains an explicit dialogue test link."
source_app_id = "navigator"

[sub_resource type="Resource" id="Step_install_navigator"]
script = ExtResource("3_step")
step_id = "install_navigator"
step_type = 7
app_id = "navigator"

[sub_resource type="Resource" id="Effect_mark_sequence_applied"]
script = ExtResource("8_set_flag")
flag_name = "story.prologue.welcome_sequence_applied"
effect_id = "story.prologue.mark_welcome_sequence_applied"

[sub_resource type="Resource" id="Step_apply_effects"]
script = ExtResource("3_step")
step_id = "apply_welcome_effects"
step_type = 9
effects = Array[ExtResource("7_effect")]([SubResource("Effect_mark_sequence_applied")])

[sub_resource type="Resource" id="Trigger_account_ready"]
script = ExtResource("2_trigger")
trigger_type = 3
watched_flag_name = "story.prologue.account_ready"

[resource]
script = ExtResource("1_event")
event_id = "story.prologue.null_network_welcome"
priority = 100
conditions = SubResource("Conditions_root")
trigger = SubResource("Trigger_account_ready")
steps = Array[ExtResource("3_step")]([SubResource("Step_open_browser"), SubResource("Step_navigate_browser"), SubResource("Step_show_alert"), SubResource("Step_show_notification"), SubResource("Step_install_navigator"), SubResource("Step_apply_effects")])
completion_effects = Array[ExtResource("7_effect")]([SubResource("Effect_mark_complete")])
