[resource]
script = ExtResource("1_status")
status_id = &"unstability"
display_name = "UNSTABILITY"
classification = &"unstability"
description = "Receives double damage during the next cycle."
duration_cycles = 1
triggered_effects = Array[ExtResource("2_triggered")]([SubResource("Triggered_double_damage")])
