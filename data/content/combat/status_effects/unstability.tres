[sub_resource type="Resource" id="Target_holder"]
script = ExtResource("5_target")
target_kind = 9

[sub_resource type="Resource" id="Formula_double"]
script = ExtResource("6_formula")
base_value = 2.0

[sub_resource type="Resource" id="Effect_damage_taken"]
script = ExtResource("4_effect")
effect_type = 7
target_selector = SubResource("Target_holder")
