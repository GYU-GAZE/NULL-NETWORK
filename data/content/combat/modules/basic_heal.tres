[gd_resource type="Resource" script_class="ModuleData" format=3 uid="uid://dc21a0ovikmof"]

[ext_resource type="Script" uid="uid://c5i2yudu22p4m" path="res://data/templates/module_data.gd" id="1_module"]
[ext_resource type="Script" uid="uid://rnthl5gqx7w1" path="res://data/templates/combat_effect_data.gd" id="2_effect"]
[ext_resource type="Script" uid="uid://d0h7kubwmgtyk" path="res://data/templates/combat_target_selector.gd" id="3_target"]
[ext_resource type="Script" uid="uid://2s4dc3vux8i3" path="res://data/templates/combat_value_formula.gd" id="4_formula"]
[ext_resource type="Script" uid="uid://dxoqpn82ahfe" path="res://data/templates/combat/combat_tendency_gain_data.gd" id="5_gain"]

[sub_resource type="Resource" id="Target_self"]
script = ExtResource("3_target")
target_kind = 0

[sub_resource type="Resource" id="Formula_heal"]
script = ExtResource("4_formula")
stat_reference = 1
stat = 1
stat_multiplier = 0.15
use_effective_stat = true
secondary_stat_multiplier = 0.1
secondary_use_effective_stat = true
use_minimum = true
minimum_value = 2.0

[sub_resource type="Resource" id="Effect_heal"]
script = ExtResource("2_effect")
effect_type = 1
target_selector = SubResource("Target_self")
value_formula = SubResource("Formula_heal")
can_crit = false

[sub_resource type="Resource" id="Gain_sync"]
script = ExtResource("5_gain")
tendency = 2
amount = 2

[resource]
script = ExtResource("1_module")
module_id = &"basic_heal"
module_name = "Heal"
classification = &"healing"
description = "Restores HP using the target's Max HP and a configurable caster stat."
module_tags = 2
combat_effects = Array[ExtResource("2_effect")]([SubResource("Effect_heal")])
combat_tendency_gains = Array[ExtResource("5_gain")]([SubResource("Gain_sync")])
