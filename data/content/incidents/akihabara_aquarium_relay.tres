[ext_resource type="Script" uid="uid://b83h03ewt815j" path="res://data/templates/effects/set_flag_effect_data.gd" id="5_flag"]
[ext_resource type="Resource" path="res://data/content/activities/investigate_aquarium_relay.tres" id="6_activity"]
[ext_resource type="Resource" uid="uid://ilvu0pe07j0x" path="res://data/content/dialogues/akihabara_aquarium_relay.tres" id="7_dialogue"]
