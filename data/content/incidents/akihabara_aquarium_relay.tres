[sub_resource type="Resource" id="Effect_resolved"]
script = ExtResource("5_flag")
flag_name = "incident.akihabara_aquarium_relay.resolved"
effect_id = "incident.akihabara_aquarium_relay.mark_resolved"

[sub_resource type="Resource" id="Effect_party_leave"]
script = ExtResource("9_party")
npc_id = "ganbarekun"
use_context_target_when_empty = false
owner_id = "lead.integration_field_test"
use_context_source_when_owner_empty = false
operation = 1
effect_id = "incident.akihabara_aquarium_relay.party_leave"

[sub_resource type="Resource" id="Branch_victory"]
script = ExtResource("3_branch")
effects = Array[ExtResource("4_effect")]([SubResource("Effect_resolved"), SubResource("Effect_party_leave")])

[sub_resource type="Resource" id="Branch_defeat"]
script = ExtResource("3_branch")
outcome = 1
completes_incident = false
completes_lead = false

[sub_resource type="Resource" id="Branch_escape"]
script = ExtResource("3_branch")
outcome = 2
completes_incident = false
completes_lead = false

[sub_resource type="Resource" id="Stage_trace"]
script = ExtResource("2_stage")
stage_id = "trace_relay"
title = "Trace the relay"
dialogue = ExtResource("7_dialogue")
encounter = ExtResource("8_encounter")

[resource]
script = ExtResource("1_incident")
incident_id = "akihabara_aquarium_relay"
title = "Aquarium Relay"
description = "A distorted Aquarium signal is being repeated from a hidden Akihabara relay."
location_id = "akihabara"
activity_definition = ExtResource("6_activity")
dialogue = ExtResource("7_dialogue")
encounter = ExtResource("8_encounter")
initial_stage_id = "trace_relay"
stages = Array[ExtResource("2_stage")]([SubResource("Stage_trace")])
resolution_branches = Array[ExtResource("3_branch")]([SubResource("Branch_victory"), SubResource("Branch_defeat"), SubResource("Branch_escape")])
