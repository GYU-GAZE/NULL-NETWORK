[gd_resource type="Resource" script_class="SocialInteractionData" load_steps=8 format=3]

[ext_resource type="Script" path="res://data/templates/social/social_interaction_data.gd" id="1_interaction"]
[ext_resource type="Resource" path="res://data/content/activities/social/ganbarekun_strategy_chat.tres" id="2_activity"]
[ext_resource type="Script" path="res://data/templates/effects/conditional_effect_bundle_data.gd" id="3_bundle"]
[ext_resource type="Script" path="res://data/templates/effects/game_effect_data.gd" id="4_effect"]
[ext_resource type="Script" path="res://data/templates/effects/modify_affinity_effect_data.gd" id="5_affinity"]
[ext_resource type="Script" path="res://data/templates/effects/add_lead_effect_data.gd" id="6_lead"]

[sub_resource type="Resource" id="Effect_affinity"]
script = ExtResource("5_affinity")
effect_id = "social.ganbarekun.field_test.affinity"
npc_id = "ganbarekun"
use_context_target_when_empty = false
operation = 0
value = 2

[sub_resource type="Resource" id="Effect_lead"]
script = ExtResource("6_lead")
