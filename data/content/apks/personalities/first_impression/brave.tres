[gd_resource type="Resource" script_class="APKFirstImpressionProfileData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/templates/apk/apk_first_impression_profile_data.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_id = "brave"
fallback_line = "We're partners now. Whatever waits outside this screen, we'll face it together."
reaction_by_trait = {"reactive": 2, "proactive": 0, "improvisational": 1, "structured": 0, "independent": 1, "collective": 0, "reserved": 1, "expressive": 0, "detached": 2, "attached": 0, "familiar": 2, "curious": 0, "present_oriented": 1, "aspiring": 0}
line_by_trait = {"reactive": "You wait until the situation forces your hand. I won't pretend I understand that... but if you freeze, I'll remind you why we have to move.", "proactive": "You move first when something has to be done. Good. I'd rather follow someone who chooses a direction than someone who waits for one.", "improvisational": "You trust yourself to find the answer while you're moving. Risky... but courage without uncertainty wouldn't mean much, would it?", "structured": "You prepare before you commit. Good. When the moment comes, I expect you to trust that preparation and act.", "independent": "You rely on your own judgment. I respect that. Just remember that accepting a partner means you don't have to carry every decision alone.", "collective": "You think about who stands beside you before you act. That's the kind of strength I can believe in.", "reserved": "You keep a lot behind your teeth. Fine. You don't need speeches to prove yourself; your choices will do that.", "expressive": "You don't hide where you stand. Good. If we're going to fight together, I never want to wonder whether you mean what you say.", "detached": "You can cut something loose when it becomes a burden. Maybe that's useful. Just make sure necessity doesn't become an excuse.", "attached": "You don't abandon people once they matter to you. That's the attitude I wanted to see. I think we're going to get along.", "familiar": "You prefer ground you already understand. I get it, but sooner or later we're going to have to step somewhere dangerous on purpose.", "curious": "You'd rather face the unknown than leave it unanswered. Good. Whatever we find, we'll meet it head-on.", "present_oriented": "You deal with the problem in front of you instead of chasing some distant ideal. That's solid. Just don't stop imagining what comes after it.", "aspiring": "You're aiming at something beyond where you are now. Good. Then let's become strong enough to reach it."}
