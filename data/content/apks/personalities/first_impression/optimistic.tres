[gd_resource type="Resource" script_class="APKFirstImpressionProfileData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/templates/apk/apk_first_impression_profile_data.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_id = "optimistic"
fallback_line = "Hey, we're linked now! I don't know what comes next either, but that makes two of us."
reaction_by_trait = {"reactive": 1, "proactive": 0, "improvisational": 0, "structured": 1, "independent": 1, "collective": 0, "reserved": 1, "expressive": 0, "detached": 2, "attached": 0, "familiar": 1, "curious": 0, "present_oriented": 1, "aspiring": 0}
line_by_trait = {"reactive": "You like to see what happens before you move, huh? That's okay. I'll make sure we don't miss our chance when it shows up.", "proactive": "You don't wait around for permission, do you? Nice. I think keeping up with you is going to be fun.", "improvisational": "Plans are useful right up until the world ignores them. You seem good at the part that comes after that.", "structured": "You actually think things through before jumping in. Good! One of us should remember to do that.", "independent": "You trust yourself first. I can work with that. Just remember you've got me now too.", "collective": "You keep looking for the people beside you before choosing a direction. I like that. Let's make sure neither of us gets left behind.", "reserved": "You're hard to read. That's fine. I'll learn the difference between your quiet and your worried eventually.", "expressive": "Oh, good. You actually say what you're thinking. That'll save us a lot of guessing.", "detached": "You let go pretty easily, don't you? ...All right. Just don't decide I'm disposable before we've even started.", "attached": "You don't give up on people easily. Heh. I think I'm going to like being on your side.", "familiar": "You'd rather know where you're stepping before you move. Fair enough. I'll point out anything interesting off the path.", "curious": "You see a question mark and immediately want to poke it, don't you? Perfect. I was hoping you'd say that.", "present_oriented": "You're paying attention to what's in front of you instead of some imaginary finish line. That's not a bad way to start.", "aspiring": "You're already looking past where you are now. Good. Let's see how far we can actually get."}
