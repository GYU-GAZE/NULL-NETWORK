[gd_resource type="Resource" script_class="APKFirstImpressionProfileData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/templates/apk/apk_first_impression_profile_data.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_id = "wise"
fallback_line = "The Assessment is only a first reading. What matters is whether your decisions remain yours once the circumstances change."
reaction_by_trait = {"reactive": 0, "proactive": 1, "improvisational": 1, "structured": 0, "independent": 0, "collective": 1, "reserved": 0, "expressive": 1, "detached": 1, "attached": 1, "familiar": 1, "curious": 0, "present_oriented": 1, "aspiring": 0}
line_by_trait = {"reactive": "You prefer to understand a situation before becoming part of it. Sensible. Observation is only a weakness when it becomes an excuse never to act.", "proactive": "Your instinct is to alter the situation before it can settle around you. Useful. Just remember that the first move is not automatically the correct one.", "improvisational": "You leave room for the situation to teach you what the plan could not. Good. Keep enough structure to recognize when improvisation stops working.", "structured": "You reduce uncertainty before you commit. We should work well together. A plan is most valuable when you also know when to abandon it.", "independent": "You place considerable trust in your own judgment. That can make your decisions clear. It can also make your blind spots very quiet.", "collective": "You account for other people before deciding what success means. Useful. Consensus and responsibility are not the same thing, though. Remember that.", "reserved": "You don't spend words before you need them. I appreciate that. I'll pay attention to what you choose not to say as well.", "expressive": "You make your position visible. That gives people something honest to respond to. Be careful not to mistake being understood for being correct.", "detached": "You can separate yourself from what would cloud a decision. Valuable, sometimes. Make sure distance doesn't make other people look smaller than they are.", "attached": "Your bonds weigh heavily in your decisions. That isn't irrational. It only means you should know exactly what you're willing to risk for them.", "familiar": "You prefer information whose shape you already understand. Reliable. Just remember that unfamiliar evidence does not become less true because it is inconvenient.", "curious": "Uncertainty seems to pull you toward it rather than away. Good. Questions are useful tools, provided you can survive the answers.", "present_oriented": "You judge the situation that exists instead of the future you wish existed. Grounded. Don't let realism quietly become surrender.", "aspiring": "You evaluate the present by what it could become. That can carry you far. It can also make the present look disposable. Keep both in view."}
