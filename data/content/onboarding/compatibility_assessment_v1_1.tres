[sub_resource type="Resource" id="Q18"]
script = ExtResource("2_question")
question_id = "Q18"
category = 2
prompt = "A catastrophic failure leaves a medical reconstruction server with enough capacity to preserve only one conscious mind. Whatever is preserved can later continue living. Whatever is lost will be permanently destroyed.

The first mind belongs to a living person whose brain was irreversibly damaged in an accident. A recent neural backup can be restored into their repaired biological body, effectively bringing them back. Before the accident, this person had a long history of abusing and exploiting people around them. Their family had cut contact with them years ago, and nobody close to them is asking for their return.

The second mind originated from an APK. It has never possessed a biological body, but it is fully conscious, remembers years of experiences and has developed a close relationship with an orphaned child who became deeply attached to it after losing their parents. The child is begging you not to erase it.

Both minds are currently conscious. Both understand what is happening. Both ask you to save them. You must allocate the remaining capacity."
measured_axes = PackedStringArray("STR", "ATT", "CUR")
answers = Array[ExtResource("3_answer")]([SubResource("Q18A"), SubResource("Q18B"), SubResource("Q18C"), SubResource("Q18D")])

