[sub_resource type="Resource" id="Q01A"]
script = ExtResource("3_answer")
text = "I make a short list and use the time on something I've been putting off."
axis_weights = {
"ASP": 2,
"INI": 1,
"STR": 2
}

[sub_resource type="Resource" id="Q01B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I pick somewhere to go and leave before I overthink it."
axis_weights = {
"ASP": -1,
"INI": 2,
"STR": -1
}
variant_key = "COMBUSTIVE"

[sub_resource type="Resource" id="Q01C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I keep the afternoon open and follow whatever seems interesting at the time."
axis_weights = {
"ASP": 1,
"INI": -1,
"STR": -2
}

[sub_resource type="Resource" id="Q01D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I rest. If nothing needs doing today, I don't invent work for myself."
axis_weights = {
"ASP": -2,
"INI": -2,
"STR": 1
}

[sub_resource type="Resource" id="Q01"]
script = ExtResource("2_question")
prompt = "You unexpectedly get an entire afternoon with nothing planned. What do you do?"
measured_axes = PackedStringArray("INI", "STR", "ASP")
answers = Array[ExtResource("3_answer")]([SubResource("Q01A"), SubResource("Q01B"), SubResource("Q01C"), SubResource("Q01D")])

[sub_resource type="Resource" id="Q02A"]
script = ExtResource("3_answer")
text = "I find a beginner course or guide and work through it properly."
axis_weights = {
"ASP": 2,
"CUR": -1,
"INI": 1,
"STR": 2
}

[sub_resource type="Resource" id="Q02B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I start messing with it immediately and learn from whatever happens."
axis_weights = {
"ASP": -1,
"CUR": 2,
"INI": 2,
"STR": -2
}
variant_key = "COMBUSTIVE"

[sub_resource type="Resource" id="Q02C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I find people who already do it, ask what they wish they knew at the beginning, and decide how deep I want to go."
axis_weights = {
"ASP": 1,
"CUR": 1,
"INI": -1,
"STR": 1
}
variant_key = "CONDUCTIVE"

[sub_resource type="Resource" id="Q02D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I try it casually with whatever I already have. It doesn't need to become a whole project."
axis_weights = {
"ASP": -2,
"CUR": -2,
"INI": -2,
"STR": -1
}

[sub_resource type="Resource" id="Q02"]
script = ExtResource("2_question")
question_id = "Q02"
prompt = "You decide to try a hobby you know almost nothing about. How do you start?"
measured_axes = PackedStringArray("INI", "STR", "CUR", "ASP")
answers = Array[ExtResource("3_answer")]([SubResource("Q02A"), SubResource("Q02B"), SubResource("Q02C"), SubResource("Q02D")])

[sub_resource type="Resource" id="Q03A"]
script = ExtResource("3_answer")
text = "I ask them directly if something is going on."
axis_weights = {
"ATT": 2,
"EXP": 1,
"SOC": 1
}
variant_key = "CONDUCTIVE"

[sub_resource type="Resource" id="Q03B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I say it's fine and wait for them to reach out next time."
axis_weights = {
"ATT": -1,
"EXP": -1,
"SOC": -1
}
variant_key = "DECEPTIVE"

[sub_resource type="Resource" id="Q03C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I tell them that it's starting to bother me and ask if they still want to make plans together."
axis_weights = {
"ATT": 1,
"EXP": 2,
"SOC": 2
}
variant_key = "COMBUSTIVE"

[sub_resource type="Resource" id="Q03D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I stop inviting them for a while. No confrontation necessary."
axis_weights = {
"ATT": -2,
"EXP": -2,
"SOC": -2
}
variant_key = "DEFENSIVE"

[sub_resource type="Resource" id="Q03"]
script = ExtResource("2_question")
question_id = "Q03"
prompt = "A friend cancels plans with you at the last minute. It's the third time recently."
measured_axes = PackedStringArray("SOC", "EXP", "ATT")
answers = Array[ExtResource("3_answer")]([SubResource("Q03A"), SubResource("Q03B"), SubResource("Q03C"), SubResource("Q03D")])

[sub_resource type="Resource" id="Q04A"]
script = ExtResource("3_answer")
text = "I help stabilize the injury and return together with the others using the route we already know."
axis_weights = {
"ATT": 1,
"CUR": -2,
"INI": -1,
"STR": 2
}
tendency_weights = {
"logic": 2,
"sync": 1
}
variant_key = "DEFENSIVE"

[sub_resource type="Resource" id="Q04B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I stay sheltered with the injured person while one of the others goes ahead to look for help."
axis_weights = {
"ATT": 2,
"CUR": -1,
"INI": -2,
"STR": 1
}
tendency_weights = {
"logic": 1,
"sync": 2
}
variant_key = "CONDUCTIVE"

[sub_resource type="Resource" id="Q04C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I leave the others somewhere sheltered and take a shorter route back to look for help, even though none of us have taken it before."
axis_weights = {
"ATT": -1,
"CUR": 2,
"INI": 2,
"STR": -2
}
tendency_weights = {
"logic": 1,
"valour": 2
}
variant_key = "DESTRUCTIVE"

[sub_resource type="Resource" id="Q04D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I leave the injured person with the others and search the nearby area for somewhere with signal, better shelter or another route."
axis_weights = {
"ATT": -2,
"CUR": 1,
"INI": 1,
"STR": -1
}
tendency_weights = {
"logic": 2,
"valour": 1
}
variant_key = "CORROSIVE"

[sub_resource type="Resource" id="Q04"]
script = ExtResource("2_question")
question_id = "Q04"
category = 1
prompt = "You're hiking with three other people when one of them badly injures their ankle. There's no phone signal, and a storm is getting closer. What do you do?"
measured_axes = PackedStringArray("INI", "STR", "ATT", "CUR")
answers = Array[ExtResource("3_answer")]([SubResource("Q04A"), SubResource("Q04B"), SubResource("Q04C"), SubResource("Q04D")])

[sub_resource type="Resource" id="Q05A"]
script = ExtResource("3_answer")
text = "“Sure. Call me when you can.”"
axis_weights = {
"ATT": 2,
"EXP": -1,
"INI": 2,
"SOC": 2
}
variant_key = "CONDUCTIVE"

[sub_resource type="Resource" id="Q05B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "“What is this about?”"
axis_weights = {
"ATT": -1,
"EXP": 1,
"INI": 1,
"SOC": -1
}
variant_key = "CORROSIVE"

[sub_resource type="Resource" id="Q05C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "“We haven't spoken in years. Tell me why you're reaching out first.”"
axis_weights = {
"ATT": 1,
"EXP": 2,
"INI": -1,
"SOC": 1
}
variant_key = "CRYOSIVE"

[sub_resource type="Resource" id="Q05D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I leave it unanswered. If it's important, they'll explain."
axis_weights = {
"ATT": -2,
"EXP": -2,
"INI": -2,
"SOC": -2
}

[sub_resource type="Resource" id="Q05"]
script = ExtResource("2_question")
question_id = "Q05"
prompt = "Someone you haven't spoken to in years suddenly messages you: “hey. can we talk?”"
measured_axes = PackedStringArray("INI", "SOC", "EXP", "ATT")
answers = Array[ExtResource("3_answer")]([SubResource("Q05A"), SubResource("Q05B"), SubResource("Q05C"), SubResource("Q05D")])

[sub_resource type="Resource" id="Q06A"]
script = ExtResource("3_answer")
text = "I go to them and start telling specific people to call emergency services and get station staff."
axis_weights = {
"EXP": 2,
"INI": 2,
"STR": -1
}
tendency_weights = {
"sync": 1,
"valour": 2
}
variant_key = "COMBUSTIVE"

[sub_resource type="Resource" id="Q06B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I call emergency services myself and follow whatever instructions they give me."
axis_weights = {
"EXP": 1,
"INI": 1,
"STR": 2
}
tendency_weights = {
"logic": 2,
"valour": 1
}
variant_key = "CRYOSIVE"

[sub_resource type="Resource" id="Q06C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I get station staff and stay clear so people who know what they're doing have room."
axis_weights = {
"EXP": -1,
"INI": -1,
"STR": 1
}
tendency_weights = {
"logic": 1,
"sync": 2
}
variant_key = "DEFENSIVE"

[sub_resource type="Resource" id="Q06D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I stay nearby but avoid interfering unless somebody asks me to do something."
axis_weights = {
"EXP": -2,
"INI": -2,
"STR": -2
}
tendency_weights = {
"logic": 1,
"self": 1
}

[sub_resource type="Resource" id="Q06"]
script = ExtResource("2_question")
question_id = "Q06"
category = 1
prompt = "Someone suddenly collapses in a crowded train station. For a few seconds, everyone around them just freezes."
measured_axes = PackedStringArray("INI", "STR", "EXP")
answers = Array[ExtResource("3_answer")]([SubResource("Q06A"), SubResource("Q06B"), SubResource("Q06C"), SubResource("Q06D")])

[sub_resource type="Resource" id="Q07A"]
script = ExtResource("3_answer")
text = "I help them fix as much as possible and give them one chance to disclose the problem themselves."
axis_weights = {
"ASP": -1,
"ATT": 2,
"CUR": 1,
"EXP": 1
}
tendency_weights = {
"logic": 1,
"sync": 2
}
variant_key = "DEPLETIVE"

[sub_resource type="Resource" id="Q07B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I report what I know immediately, even though I know what it will cost them."
axis_weights = {
"ASP": 2,
"ATT": -2,
"CUR": -2,
"EXP": 2
}
tendency_weights = {
"logic": 2,
"valour": 1
}
variant_key = "DESTRUCTIVE"

[sub_resource type="Resource" id="Q07C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I secretly investigate the damage first. I want to know exactly how dangerous the situation is before deciding."
axis_weights = {
"ASP": 1,
"ATT": -1,
"CUR": 2,
"EXP": -2
}
tendency_weights = {
"logic": 2,
"self": 1
}
variant_key = "CORROSIVE"

[sub_resource type="Resource" id="Q07D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I help them conceal the mistake while we correct it. If we can undo the damage, nobody else needs to know."
axis_weights = {
"ASP": -2,
"ATT": 1,
"CUR": -1,
"EXP": -1
}
tendency_weights = {
"self": 2,
"sync": 1
}
variant_key = "DECEPTIVE"

[sub_resource type="Resource" id="Q07"]
script = ExtResource("2_question")
question_id = "Q07"
category = 1
prompt = "Someone you work or study with privately admits they've been hiding serious mistakes for weeks. If the problem is discovered, they'll almost certainly lose their job or be expelled. If it continues unnoticed, however, other people may eventually be seriously harmed by the consequences. They beg you to help them fix it without telling anyone. What do you do?"
measured_axes = PackedStringArray("EXP", "ATT", "CUR", "ASP")
answers = Array[ExtResource("3_answer")]([SubResource("Q07A"), SubResource("Q07B"), SubResource("Q07C"), SubResource("Q07D")])

[sub_resource type="Resource" id="Q08A"]
script = ExtResource("3_answer")
text = "I look up the model and find the instructions online before starting."
axis_weights = {
"CUR": -1,
"INI": 1,
"STR": 2
}
variant_key = "CRYOSIVE"

[sub_resource type="Resource" id="Q08B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I start assembling it and correct things as I figure out how it works."
axis_weights = {
"CUR": 2,
"INI": 2,
"STR": -2
}
variant_key = "COMBUSTIVE"

[sub_resource type="Resource" id="Q08C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I lay everything out and try to infer the intended order from the pieces."
axis_weights = {
"CUR": 1,
"INI": -1,
"STR": 1
}
variant_key = "CORROSIVE"

[sub_resource type="Resource" id="Q08D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I leave it alone until I can ask someone who knows what they're doing."
axis_weights = {
"CUR": -2,
"INI": -2,
"STR": -1
}
variant_key = "DEFENSIVE"

[sub_resource type="Resource" id="Q08"]
script = ExtResource("2_question")
question_id = "Q08"
prompt = "You need to assemble something, but the instructions are missing."
measured_axes = PackedStringArray("INI", "STR", "CUR")
answers = Array[ExtResource("3_answer")]([SubResource("Q08A"), SubResource("Q08B"), SubResource("Q08C"), SubResource("Q08D")])

[sub_resource type="Resource" id="Q09A"]
script = ExtResource("3_answer")
text = "I accept it. Opportunities like this don't wait forever."
axis_weights = {
"ASP": 2,
"ATT": -2,
"EXP": -1,
"SOC": -2
}
variant_key = "DESTRUCTIVE"

[sub_resource type="Resource" id="Q09B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I talk it through with the people closest to me before deciding."
axis_weights = {
"ASP": -1,
"ATT": 2,
"EXP": 1,
"SOC": 2
}
variant_key = "CONDUCTIVE"

[sub_resource type="Resource" id="Q09C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I try to negotiate some middle ground first — a delay, temporary arrangement, remote option, anything that lets me test it before committing."
axis_weights = {
"ASP": 1,
"ATT": -1,
"EXP": 2,
"SOC": 1
}
variant_key = "CORROSIVE"

[sub_resource type="Resource" id="Q09D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I lean toward staying. A better opportunity isn't automatically a better life."
axis_weights = {
"ASP": -2,
"ATT": 1,
"EXP": -2,
"SOC": -1
}
variant_key = "DEPLETIVE"

[sub_resource type="Resource" id="Q09"]
script = ExtResource("2_question")
question_id = "Q09"
prompt = "You're offered a very good opportunity, but accepting it would require moving far away from the people and routine you currently have."
measured_axes = PackedStringArray("SOC", "EXP", "ATT", "ASP")
answers = Array[ExtResource("3_answer")]([SubResource("Q09A"), SubResource("Q09B"), SubResource("Q09C"), SubResource("Q09D")])

[sub_resource type="Resource" id="Q10A"]
script = ExtResource("3_answer")
text = "I abandon what I had planned and go help them."
axis_weights = {
"ASP": -2,
"INI": 2,
"SOC": 2
}
tendency_weights = {
"sync": 2,
"valour": 1
}
variant_key = "CONDUCTIVE"

[sub_resource type="Resource" id="Q10B"]
script = ExtResource("3_answer")
answer_id = "B"
text = "I verify their location and gather whatever information I can before deciding whether the rescue is realistic."
axis_weights = {
"ASP": -1,
"INI": 1,
"SOC": 1
}
tendency_weights = {
"logic": 2,
"sync": 1
}
variant_key = "CRYOSIVE"

[sub_resource type="Resource" id="Q10C"]
script = ExtResource("3_answer")
answer_id = "C"
text = "I forward the situation to players already nearby and continue with my plans."
axis_weights = {
"ASP": 1,
"INI": -1,
"SOC": -1
}
tendency_weights = {
"logic": 1,
"self": 1,
"sync": 1
}

[sub_resource type="Resource" id="Q10D"]
script = ExtResource("3_answer")
answer_id = "D"
text = "I continue with my plans. I won't risk my partner because a stranger got themselves into trouble."
