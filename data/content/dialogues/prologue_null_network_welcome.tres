value = 1

[sub_resource type="Resource" id="Choice_activity"]
script = ExtResource("12_activity")
activity_id = "dialogue.prologue.consider_signal"
display_name = "Consider the Signal"
description = "Spend one action investigating the signal before answering."
action_cost = 1
allow_cross_period = true
allow_cross_day = false
requires_confirmation = true
confirmation_message = "Spend 1 action to investigate the signal?"

[sub_resource type="Resource" id="Effect_logic_flag"]
script = ExtResource("10_set_flag")
effect_id = "dialogue.prologue.mark_logic_choice"
flag_name = "dialogue.phase7.logic_selected"
value = true

[sub_resource type="Resource" id="Choice_logic_paid"]
script = ExtResource("4_choice")
choice_id = "logic_paid"
text = "Analyze the signal before answering."
effects = Array[ExtResource("9_effect")]([SubResource("Effect_logic_flag")])
tendency_changes = Array[int]([0, 2, 0, 0])
next_node_id = "outro"
activity_definition = SubResource("Choice_activity")

[sub_resource type="Resource" id="Effect_valour_flag"]
script = ExtResource("10_set_flag")
effect_id = "dialogue.prologue.mark_valour_choice"
flag_name = "dialogue.phase7.valour_selected"
value = true

[sub_resource type="Resource" id="Choice_valour"]
script = ExtResource("4_choice")
choice_id = "valour"
text = "Connect immediately."
effects = Array[ExtResource("9_effect")]([SubResource("Effect_valour_flag")])
tendency_changes = Array[int]([1, 0, 0, 0])
next_node_id = "outro"

[sub_resource type="Resource" id="Effect_sync_flag"]
script = ExtResource("10_set_flag")
effect_id = "dialogue.prologue.mark_sync_choice"
flag_name = "dialogue.phase7.sync_selected"
value = true

[sub_resource type="Resource" id="Choice_sync"]
script = ExtResource("4_choice")
choice_id = "sync"
text = "Ask whether everyone else is safe."
effects = Array[ExtResource("9_effect")]([SubResource("Effect_sync_flag")])
tendency_changes = Array[int]([0, 0, 1, 0])
next_node_id = "outro"

[sub_resource type="Resource" id="Effect_self_flag"]
script = ExtResource("10_set_flag")
effect_id = "dialogue.prologue.mark_self_choice"
flag_name = "dialogue.phase7.self_selected"
value = true

[sub_resource type="Resource" id="Choice_self"]
script = ExtResource("4_choice")
choice_id = "self"
text = "Demand something in return."
