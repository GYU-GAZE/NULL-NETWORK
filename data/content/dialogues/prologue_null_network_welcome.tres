tendency_changes = Array[int]([0, 0, 0, 1])
next_node_id = "outro"

[sub_resource type="Resource" id="Condition_special_flag"]
script = ExtResource("8_flag_condition")
flag_name = "dialogue.phase7.special_unlocked"
expected_value = true

[sub_resource type="Resource" id="Conditions_special"]
script = ExtResource("7_condition_set")
match_mode = 0
rules = Array[ExtResource("6_rule")]([SubResource("Condition_special_flag")])

[sub_resource type="Resource" id="Effect_special_flag"]
script = ExtResource("10_set_flag")
effect_id = "dialogue.prologue.mark_special_choice"
flag_name = "dialogue.phase7.special_selected"
value = true

[sub_resource type="Resource" id="Choice_special"]
script = ExtResource("4_choice")
choice_id = "special"
text = "[SPECIAL] Reply using the hidden handshake."
conditions = SubResource("Conditions_special")
effects = Array[Ext_resource("9_effect")]([SubResource("Effect_special_flag")])
tendency_changes = Array[int]([0, 1, 1, 0])
next_node_id = "outro"

[sub_resource type="Resource" id="Node_intro"]
script = ExtResource("3_node")
node_id = "intro"
speaker_id = "player"
text = "Connection established.\nOperator signature accepted.\nNavigator channel mounted.\nSix encrypted profiles resolved.\nNo route is marked as safe.\nThe network is listening."
portrait_states = Array[ExtResource("5_portrait_state")]([SubResource("Portrait_left_1"), SubResource("Portrait_left_2"), SubResource("Portrait_left_3"), SubResource("Portrait_right_1"), SubResource("Portrait_right_2"), SubResource("Portrait_right_3")])
effects_on_enter = Array[ExtResource("9_effect")]([SubResource("Effect_intro_counter")])
next_node_id = "decision"

[sub_resource type="Resource" id="Node_decision"]
script = ExtResource("3_node")
node_id = "decision"
speaker_id = "tenya"
text = "The channel recognizes your registration signature.\nThe handshake remains incomplete.\nSix profiles are watching the same route.\nYour first response will be logged.\nThe network will remember the pattern.\nHow do you answer?"
portrait_states = Array[ExtResource("5_portrait_state")]([SubResource("Portrait_left_1"), SubResource("Portrait_left_2"), SubResource("Portrait_left_3"), SubResource("Portrait_right_1"), SubResource("Portrait_right_2"), SubResource("Portrait_right_3")])
choices = Array[ExtResource("4_choice")]([SubResource("Choice_logic_paid"), SubResource("Choice_valour"), SubResource("Choice_sync"), SubResource("Choice_self"), SubResource("Choice_special")])

[sub_resource type="Resource" id="Effect_outro_flag"]
script = ExtResource("10_set_flag")
effect_id = "dialogue.prologue.mark_outro_entered"
flag_name = "dialogue.phase7.outro_entered"
value = true

[sub_resource type="Resource" id="Node_outro"]
script = ExtResource("3_node")
node_id = "outro"
speaker_id = "tenya"
text = "Acknowledged. The rest of the network is now listening."
portrait_states = Array[ExtResource("5_portrait_state")]([SubResource("Portrait_left_1"), SubResource("Portrait_left_2"), SubResource("Portrait_left_3"), SubResource("Portrait_right_1"), SubResource("Portrait_right_2"), SubResource("Portrait_right_3")])
effects_on_enter = Array[ExtResource("9_effect")]([SubResource("Effect_outro_flag")])

[resource]
script = ExtResource("1_dialogue")
dialogue_id = "dialogue.prologue.null_network_welcome"
initial_node_id = "intro"
speakers = Array[ExtResource("2_speaker")]([SubResource("Speaker_player"), SubResource("Speaker_partner"), SubResource("Speaker_ally"), SubResource("Speaker_tenya"), SubResource("Speaker_nursery"), SubResource("Speaker_ganbare")])
nodes = Array[ExtResource("3_node")]([SubResource("Node_intro"), SubResource("Node_decision"), SubResource("Node_outro")])
