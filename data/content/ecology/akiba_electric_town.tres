[gd_resource type="Resource" script_class="EcologyZoneData" format=3]
[ext_resource type="Script" path="res://data/templates/ecology/ecology_zone_data.gd" id="s"]
[ext_resource type="Script" path="res://data/templates/ecology/ecology_species_data.gd" id="type"]
